# Copy this file to .env for local development.
# Docker Compose reads these values from the repository root.

# Backend
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/civicpulse
AI_SERVICE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret-before-sharing-or-deploying

# Optional Gemini-powered chatbot (fallback responses work without a key)
GEMINI_API_KEY=

# Frontend (Vite reads these at build time)
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# AI vision service
AI_SERVICE_PORT=5000

# MongoDB
MONGO_PORT=27017
